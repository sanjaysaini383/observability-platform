# Copy this file to .env and fill in your values
# Get a free Groq API key at: https://console.groq.com

GROQ_API_KEY=your_groq_key_here
# Payment Service (Razorpay Test Mode)
# Create a free account at razorpay.com to get test keys
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
# Notification Service (Gmail SMTP)
# Use a free Gmail account, you may need to generate an App Password
SMTP_USER=dummy@gmail.com
SMTP_PASS=dummy